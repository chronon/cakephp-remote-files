{
    "name": "chronon/remote-files",
    "description": "RemoteFiles plugin for CakePHP 5",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "aws/aws-sdk-php": "^3.407",
        "cakephp/cakephp": "^5.4",
        "guzzlehttp/guzzle": "^7.10 || ^8.0",
        "league/flysystem-aws-s3-v3": "^3.35"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.3",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "RemoteFiles\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RemoteFiles\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@stan",
            "@test"
        ],
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "stan": "phpstan analyse",
        "test": "phpunit --colors=always"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
